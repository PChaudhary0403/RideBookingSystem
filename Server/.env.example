# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.

# ============================================================================
# Core Application
# ============================================================================

# Required: PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/Rapido

# Required: Secret key for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secret-key-here

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Development mode: set to "true" for local dev (disables secure cookies)
# Leave unset or "false" in production.
DEV_MODE=false

# ============================================================================
# Kafka Configuration
# ============================================================================

# Broker connection (comma-separated for multiple brokers)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security (PLAINTEXT for local dev, SASL_SSL for production)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Producer tuning
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_BATCH_SIZE=32768
KAFKA_PRODUCER_LINGER_MS=50
KAFKA_PRODUCER_COMPRESSION=lz4
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true

# Consumer tuning
KAFKA_CONSUMER_MAX_POLL_RECORDS=50
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false

# Topic defaults
KAFKA_DEFAULT_NUM_PARTITIONS=12
KAFKA_DEFAULT_REPLICATION_FACTOR=1

# Outbox publisher
KAFKA_OUTBOX_POLL_INTERVAL_SECONDS=0.5
KAFKA_OUTBOX_BATCH_SIZE=50
KAFKA_OUTBOX_MAX_RETRIES=5

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_SSL=false
REDIS_MAX_CONNECTIONS=20
REDIS_DRIVER_LOCATION_TTL=120
