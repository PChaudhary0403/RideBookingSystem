# Copy this file to .env and fill in your values.
# Required: Backend API URL (no trailing slash)
VITE_API_URL=https://ridebookingsystem.onrender.com

# Required: WebSocket URL (use wss:// for production, ws:// for local)
VITE_WS_URL=wss://ridebookingsystem.onrender.com

# Required: Google Maps API key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Required: Google Maps Map ID
VITE_GOOGLE_MAPS_MAP_ID=your-map-id-here
